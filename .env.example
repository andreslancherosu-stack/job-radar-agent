# Copy this file to `.env` and put your real key in it.
#   Windows:  copy .env.example .env
# `.env` is git-ignored and must never be committed or pasted into a chat.

# Required: your Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-with-your-real-key

# Optional: override the model the agent loop uses.
JOB_RADAR_MODEL=claude-opus-5
